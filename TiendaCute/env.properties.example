DB_URL=jdbc:postgresql://localhost:5432/tiendacute
DB_USERNAME=postgres
DB_PASSWORD=cambia-esta-clave

# Obligatorio: mínimo 32 caracteres. Queda vacío a propósito para que la app
# falle con un mensaje claro si copiás este archivo sin generar el tuyo.
#   powershell -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
JWT_SECRET=

# Usuario inicial: se crea solo si la base no tiene usuarios.
# Si queda vacío no se crea nada (fail closed), no hay contraseña por defecto.
ADMIN_USER=admin
ADMIN_PASSWORD=
